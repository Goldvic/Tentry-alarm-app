{
  "expo": {
    "name": "Tentry Alarm",
    "slug": "tentry-alarm-app",
    "version": "4.5.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#05070d",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.tentry.alarmapp",
      "googleServicesFile": "./google-services.json",
      "versionCode": 18,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#05070d"
      },
      "permissions": [
        "NOTIFICATIONS",
        "VIBRATE",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "USE_FULL_SCREEN_INTENT",
        "ACCESS_NOTIFICATION_POLICY",
        "MODIFY_AUDIO_SETTINGS",
        "RECEIVE_BOOT_COMPLETED",
        "SYSTEM_ALERT_WINDOW",
        "POST_NOTIFICATIONS",
        "USE_EXACT_ALARM",
        "SCHEDULE_EXACT_ALARM",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "FOREGROUND_SERVICE_SPECIAL_USE",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ],
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#05070d"
      }
    },
    "plugins": [
      "expo-dev-client",
      "./plugins/withOverlayLauncher.js",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#05070d",
          "imageWidth": 200
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#22b8ff",
          "sounds": [
            "./assets/alarm_sound.wav"
          ],
          "mode": "production"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f203b829-d914-46fb-b625-94f21233eae0"
      }
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#05070d"
    }
  }
}
